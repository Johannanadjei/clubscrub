# ClubScrub — environment variable template
# Copy to .env.local and fill in real values. Do NOT commit .env.local.

# Paystack public key (safe in browser)
VITE_PAYSTACK_PUBLIC_KEY=

# Resend API key (server-side only — no VITE_ prefix)
RESEND_API_KEY=

# Simple admin page password
VITE_ADMIN_PASSWORD=
